#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

1 24 "app.manifest"

IDD_SETTINGS DIALOGEX 0, 0, 260, 244
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOPMOST
CAPTION "Wireless Tray — Configurações"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Dispositivos exibidos na bandeja:", -1, 10, 8, 240, 10
    CONTROL         "", IDC_DEVICES, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 10, 20, 240, 86

    LTEXT           "Atualizar a cada", -1, 10, 118, 60, 10
    EDITTEXT        IDC_INTERVAL, 72, 116, 30, 12, ES_NUMBER
    CONTROL         "", IDC_INTERVAL_SPIN, "msctls_updown32", UDS_AUTOBUDDY | UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 0, 0, 10, 12
    LTEXT           "minutos", -1, 106, 118, 40, 10

    AUTOCHECKBOX    "Avisar quando a bateria ficar abaixo de", IDC_LOWWARN, 10, 138, 142, 10
    EDITTEXT        IDC_THRESHOLD, 154, 136, 30, 12, ES_NUMBER
    CONTROL         "", IDC_THRESHOLD_SPIN, "msctls_updown32", UDS_AUTOBUDDY | UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 0, 0, 10, 12
    LTEXT           "%", -1, 188, 138, 10, 10

    AUTOCHECKBOX    "Colorir o número conforme o nível", IDC_COLORLEVELS, 10, 158, 240, 10
    LTEXT           "azul ≥ 30%  ·  laranja 15–29%  ·  vermelho < 15%  ·  verde carregando", -1, 22, 170, 228, 10

    AUTOCHECKBOX    "Iniciar com o Windows", IDC_AUTOSTART, 10, 188, 140, 10

    DEFPUSHBUTTON   "OK", IDOK, 146, 220, 50, 14
    PUSHBUTTON      "Cancelar", IDCANCEL, 200, 220, 50, 14
END
