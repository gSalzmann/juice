#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

1 24 "app.manifest"

IDD_BAR_SETTINGS DIALOGEX 0, 0, 260, 318
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Juice — Configurações"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    // Section titles are drawn bold with a thin line below (SettingsProc).
    LTEXT           "DISPOSITIVOS", IDC_SEC_DEVICES, 12, 10, 236, 9
    LTEXT           "Na barra de tarefas", IDC_LBL_BARDEVICE, 12, 30, 100, 9
    COMBOBOX        IDC_BAR_DEVICE, 112, 28, 136, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "", IDC_DEVICES, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_NOCOLUMNHEADER | WS_BORDER | WS_TABSTOP, 12, 46, 236, 62
    AUTOCHECKBOX    "Mostrar o último nível dos desconectados", IDC_SHOWLAST, 12, 114, 236, 10
    AUTOCHECKBOX    "Ler caixas de som JBL (Bluetooth LE)", IDC_JBL, 12, 128, 236, 10

    LTEXT           "ÍCONES", IDC_SEC_ICONS, 12, 150, 236, 9
    AUTOCHECKBOX    "Percentual no ícone da barra de tarefas", IDC_SHOWNUMBER, 12, 168, 236, 10
    AUTOCHECKBOX    "Colorir o número da bandeja pelo nível", IDC_COLORLEVELS, 12, 182, 236, 10

    LTEXT           "ATUALIZAÇÃO E AVISOS", IDC_SEC_REFRESH, 12, 204, 236, 9
    LTEXT           "Atualizar a cada", IDC_LBL_EVERY, 12, 224, 150, 9
    EDITTEXT        IDC_INTERVAL, 190, 222, 34, 12, ES_NUMBER | ES_RIGHT
    CONTROL         "", IDC_INTERVAL_SPIN, "msctls_updown32", UDS_AUTOBUDDY | UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 0, 0, 10, 12
    LTEXT           "min", IDC_LBL_MINUTES, 228, 224, 20, 9
    AUTOCHECKBOX    "Avisar quando a bateria ficar abaixo de", IDC_LOWWARN, 12, 240, 176, 10
    EDITTEXT        IDC_THRESHOLD, 190, 239, 34, 12, ES_NUMBER | ES_RIGHT
    CONTROL         "", IDC_THRESHOLD_SPIN, "msctls_updown32", UDS_AUTOBUDDY | UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 0, 0, 10, 12
    LTEXT           "%", IDC_LBL_PERCENT, 228, 241, 20, 9

    LTEXT           "GERAL", IDC_SEC_GENERAL, 12, 262, 236, 9
    AUTOCHECKBOX    "Iniciar com o Windows (na bandeja)", IDC_AUTOSTART, 12, 280, 236, 10

    DEFPUSHBUTTON   "OK", IDOK, 144, 298, 50, 14
    PUSHBUTTON      "Cancelar", IDCANCEL, 198, 298, 50, 14
END
